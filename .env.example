# ===========================================================================
# SECURE CHATBOT via the PRISMA AIRS AI GATEWAY - ENVIRONMENT CONFIGURATION
# ===========================================================================
# Copy to .env and fill in. Never commit .env. Real environment variables win
# over values in this file.
#
# Everything the chatbot needs from the gateway side is set up once in Strata
# Cloud Manager (see README, "Gateway-side setup"). The app itself holds only
# a gateway service key: no provider keys, no AIRS scan key.
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Gateway base URL, ending in /v1.
#   Hosted (every AIRS tenant):  https://aigw.portkey.ai/v1
#   Hybrid data plane:           https://<your-gateway-host>/v1
#   Local mock (no tenant):      http://127.0.0.1:8790/v1
AIGW_BASE_URL=https://aigw.portkey.ai/v1

# Service key from Strata Cloud Manager > AI Gateway > Security Keys.
# Mint one key per app so budgets, rate limits, and revocation are per app.
# A standalone Portkey (api.portkey.ai) key will NOT work here.
AIGW_API_KEY=your_gateway_service_key_here

# Model in catalog form: @<provider-slug>/<model>. The slug is the one you
# gave the provider under Catalogs > LLMs. Leave empty only if AIGW_CONFIG
# (or the key's default config) names the model.
AIGW_MODEL=@openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# GUARDRAIL ROUTING (one of these, or a default config on the key)
# ---------------------------------------------------------------------------

# Saved config id (pc-...) whose input_guardrails/output_guardrails reference
# your Prisma AIRS guardrail (pg-...). Leave EMPTY when the guardrail is
# attached at the workspace level (Workspace Control > Workspace Guardrails)
# or org level, or as the key's default config; sending it again would scan
# every request twice.
# Open-source gateway users can paste an inline JSON config here instead.
AIGW_CONFIG=

# Bare provider type for header routing (openai, anthropic, bedrock, ...).
# Not needed with an @slug model or a config. Leave empty normally.
AIGW_PROVIDER=

# ---------------------------------------------------------------------------
# ATTRIBUTION (shows up in the gateway's Observability view)
# ---------------------------------------------------------------------------
AIGW_APP_NAME=secure-chatbot-gateway
# Defaults to your OS username. Portkey stores it as the reserved _user key.
# AIGW_USER=jane.doe

# ---------------------------------------------------------------------------
# OPTIONAL: side-by-side comparison with a direct Prisma AIRS scan
# ---------------------------------------------------------------------------
# When both are set, every turn is ALSO scanned by calling the AIRS scan API
# directly (the way the sibling secure_chatbot repos do), and the two
# verdicts are shown next to each other. Useful for "API vs gateway" demos.
# PANW_AI_SEC_API_KEY=your_airs_scan_api_key
# PANW_AI_SEC_PROFILE_NAME=your_security_profile_name
# PANW_AI_SEC_ENDPOINT=https://service.api.aisecurity.paloaltonetworks.com

# ---------------------------------------------------------------------------
# OPTIONAL: chat and web settings
# ---------------------------------------------------------------------------
# CHAT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# CHAT_MAX_TOKENS=600
# CHAT_MAX_HISTORY=20
# REQUEST_TIMEOUT=60

# Web UI bind address. 127.0.0.1 for a laptop; 0.0.0.0 on a VM so you can
# open it from your browser (then firewall the port appropriately).
WEB_HOST=127.0.0.1
WEB_PORT=8000
